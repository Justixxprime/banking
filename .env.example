# Copy this file to .env for local development:   copy .env.example .env
# NEVER commit .env to Git and never paste its values into chats or screenshots.

PORT=3000
NODE_ENV=development

# Neon connection string (Neon console > your project > Connect). Use the DEV branch locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# A long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-secret

# true = create the demo customer and administrator on an EMPTY database.
# Use false online (production).
SEED_DEMO_DATA=true

# Used to create the administrator when SEED_DEMO_DATA=false and none exists,
# and by the migration script to replace the copied administrator password.
# Password needs 10+ characters. Leave blank locally.
ADMIN_NAME=Aurum Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
